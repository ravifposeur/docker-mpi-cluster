COMPOSE_PROJECT_NAME=docker-mpi-cluster

# Jumlah worker node
WORKER_COUNT=3

# Slot proses per node (total slot = (WORKER_COUNT + 1) * SLOTS_PER_NODE)
SLOTS_PER_NODE=2

# Konfigurasi benchmark
PI_SAMPLES=100000000
BENCHMARK_NP_LIST="1 2 4 8"

# SSH Credentials
SSH_USER=root
SSH_PASSWORD=root

# Port monitoring (host)
PORT_CADVISOR=8080
PORT_PROMETHEUS=9090
PORT_GRAFANA=3000

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
